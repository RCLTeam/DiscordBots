# ==============================================================================
# LigaBot - Configuración de Entorno
# ==============================================================================
# Copia este archivo a .env y ajusta los valores para tu entorno:
#   cp .env.example .env
#
# NUNCA subas el archivo .env con credenciales reales a control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales y Conexión con Discord Gateway
# ------------------------------------------------------------------------------
# Token secreto del bot obtenido desde el Discord Developer Portal:
# https://discord.com/developers/applications
# Obligatorio para arrancar el bot en producción o desarrollo con Discord activo.
# Puede dejarse vacío si solo se ejecutan migraciones de base de datos o tests.
DISCORD_TOKEN=tu_token_de_discord_aqui

# ID del servidor de Discord (Guild) donde opera el bot.
# Valor por defecto: 1547725310508667010 (Servidor oficial de la liga)
GUILD_ID=1547725310508667010

# ------------------------------------------------------------------------------
# 2. Roles de Discord (Permisos y Acceso por División)
# ------------------------------------------------------------------------------
# Rol de Staff / Árbitros (permiso para crear partidos, revisar tickets y gestionar canales)
STAFF_ROLE_ID=1547729760384319518

# Rol de Administradores (acceso completo a canales y comando protegido /sync)
ADMIN_ROLE_ID=1548795786110967919

# Rol de CEO de División Premier (visibilidad exclusiva sobre los canales de Premier)
CEO_PREMIER_ROLE_ID=1548795782360993842

# Rol de CEO de División Ascend (visibilidad exclusiva sobre los canales de Ascend)
CEO_ASCEND_ROLE_ID=1548795784655405087

# ------------------------------------------------------------------------------
# 3. Persistencia y Arquitectura de Motores Duales (SQLAlchemy 2.0)
# ------------------------------------------------------------------------------
# LigaBot soporta dos motores de base de datos relacional:
#
# OPCIÓN A: Desarrollo Local y Pruebas Automatizadas (PGlite)
# ------------------------------------------------------------------------------
# PGlite ejecuta PostgreSQL directamente en el proceso de Python sin requerir
# servidor externo ni contenedores Docker.
#
# 1. En memoria (efímero, ideal para suites de pruebas ultra-rápidas e idempotentes):
DATABASE_URL=pglite:///:memory:
#
# 2. Persistente en disco (guarda los datos en un directorio local para desarrollo):
# DATABASE_URL=pglite:///./.data/pglite_dev_db
#
# OPCIÓN B: Producción (PostgreSQL Asíncrono vía asyncpg)
# ------------------------------------------------------------------------------
# Para entornos de staging o producción con servidor PostgreSQL real:
# Formato: postgresql+asyncpg://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/liga_bot

# ------------------------------------------------------------------------------
# 4. Diagnósticos y Logging
# ------------------------------------------------------------------------------
# Nivel de detalle de los logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
