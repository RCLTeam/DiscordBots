# ==============================================================================
# LigaBot - Configuración de Entorno
# ==============================================================================
# Copia este archivo a .env y ajusta los valores para tu entorno:
#   cp .env.example .env
#
# NUNCA subas el archivo .env con credenciales reales a control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciales y Conexión con Discord Gateway
# ------------------------------------------------------------------------------
# Token secreto del bot obtenido desde el Discord Developer Portal:
# https://discord.com/developers/applications
# Obligatorio para arrancar el bot en producción o desarrollo con Discord activo.
# Puede dejarse vacío si solo se ejecutan migraciones de base de datos o tests.
DISCORD_TOKEN=tu_token_de_discord_aqui

# IDs de servidor, roles y canales: los valores de esta plantilla son los del
# servidor oficial de la liga y coinciden con los valores por defecto de Settings.
# En un servidor de pruebas sustitúyelos por los IDs de ese servidor. Si
# GUILD_ID, STAFF_ROLE_ID, ADMIN_ROLE_ID, CEO_PREMIER_ROLE_ID, CEO_ASCEND_ROLE_ID,
# MODERATORS_CHANNEL_ID, CASTERS_CHANNEL_ID o REGLAMENTO_CHANNEL_ID no están
# definidas, el bot usa ese valor por defecto y lo avisa en el log al arrancar.

# ID del servidor de Discord (Guild) donde opera el bot.
# Valor por defecto: 1547725310508667010 (Servidor oficial de la liga)
GUILD_ID=1547725310508667010

# ------------------------------------------------------------------------------
# 2. Roles de Discord (Permisos y Acceso por División)
# ------------------------------------------------------------------------------
# Rol de Staff / Árbitros (permiso para crear partidos, revisar tickets y gestionar canales)
STAFF_ROLE_ID=1547729760384319518

# Rol de Administradores (acceso completo a canales y comando protegido /sync)
ADMIN_ROLE_ID=1548795786110967919

# Rol de CEO de División Premier (visibilidad exclusiva sobre los canales de Premier)
CEO_PREMIER_ROLE_ID=1548795782360993842

# Rol de CEO de División Ascend (visibilidad exclusiva sobre los canales de Ascend)
CEO_ASCEND_ROLE_ID=1548795784655405087

# Rol de CEO general de la liga
CEO_ROLE_ID=0

# Rol 'Sin Verificar' asignado a nuevos miembros antes de completar onboarding
SIN_VERIFICAR_ROLE_ID=0

# Categoría de Discord donde se abren los canales de solicitud y verificación de rol
TICKET_ROL_CATEGORY_ID=0

# Nombre textual del rol asignado a agentes libres en el servidor
FREE_ROLE_NAME=Libre

# Rol de Caster para interactuar con el panel de casters (0 desactiva la restricción de rol)
CASTER_ROLE_ID=0

# ID del canal de Discord donde se publica el panel de casters
CASTERS_CHANNEL_ID=1550210628361392278

# ID del canal de moderadores (#moderators-only) donde el bot publica alertas del sistema
MODERATORS_CHANNEL_ID=1548038711697080494

# ID del canal del reglamento que se menciona en el mensaje de coordinación de cada partido
REGLAMENTO_CHANNEL_ID=1548038711697080491

# ------------------------------------------------------------------------------
# 3. Persistencia y Arquitectura de Motores Duales (SQLAlchemy 2.0)
# ------------------------------------------------------------------------------
# LigaBot soporta dos motores de base de datos relacional:
#
# OPCIÓN A: Desarrollo Local en Linux/macOS y Pruebas Automatizadas (PGlite)
# ------------------------------------------------------------------------------
# PGlite ejecuta PostgreSQL directamente en el proceso de Python sin requerir
# servidor externo ni contenedores Docker (recomendado en Linux y macOS).
#
# 1. En memoria (efímero, ideal para suites de pruebas ultra-rápidas e idempotentes):
DATABASE_URL=pglite:///:memory:
#
# 2. Persistente en disco (guarda los datos en un directorio local para desarrollo):
# DATABASE_URL=pglite:///./.data/pglite_dev_db
#
# OPCIÓN B: Desarrollo en Windows (Docker Desktop) y Producción (asyncpg)
# ------------------------------------------------------------------------------
# En Windows, debido a que Node.js / PGlite no soporta sockets de dominio UNIX
# (arrojando Error: listen EACCES), se recomienda ejecutar PostgreSQL estándar
# en un contenedor mediante Docker Desktop:
#
#   docker run -d --name postgres-liga -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=liga_bot postgres:16
#
# URL de conexión lista para usar en Windows o producción:
# Si la contraseña contiene @ / ? # % :, codifícalos (%40 %2F %3F %23 %25 %3A).
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/liga_bot

# ------------------------------------------------------------------------------
# 4. Diagnósticos y Logging
# ------------------------------------------------------------------------------
# Nivel de detalle de los logs: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. Servidor WebSocket Bridge y Sugerencias
# ------------------------------------------------------------------------------
# Habilita el servidor WebSocket interno para integración con RCL-Next
BRIDGE_ENABLED=true

# Host y puerto donde escucha el servidor WebSocket interno
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765

# Supertoken secreto requerido para autenticar conexiones WebSocket (LOG IN)
# Obligatorio para permitir la comunicación bidireccional desde la web
DISCORD_BOT_SUPERTOKEN=tu_supertoken_secreto_aqui

# ID del canal de Discord donde se publicarán las sugerencias recibidas
SUGGESTIONS_CHANNEL_ID=0

# Límite máximo global de peticiones por minuto admitidas a través de la pasarela WebSocket
BRIDGE_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 6. Auditoría de Tickets
# ------------------------------------------------------------------------------
# Rol adicional cuyos mensajes cuentan como respuesta del staff (0 lo desactiva)
ORGANIZADOR_ROLE_ID=0

# Horas sin respuesta del staff tras las que se avisa en un ticket (mínimo 1)
TICKET_REVISION_HOURS=24

# Categoría adicional que auditar además de las cinco predefinidas
# (TICKETS-GENERAL-PREMIER, TICKETS-GENERAL-ASCEND, TICKETS-FICHAJES-PREMIER,
# TICKETS-FICHAJES-ASCEND y TICKETS-ADMINISTRACION). El nombre debe coincidir
# exactamente; vacío no añade ninguna.
TICKETS_CATEGORY_NAME=
