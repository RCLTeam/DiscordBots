# Servicio systemd para LigaBot.
#
# Instalación:
#   sudo cp deploy/liga-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now liga-bot
#
# Ajusta User, WorkingDirectory y la ruta de uv a las de tu servidor.

[Unit]
Description=LigaBot - bot de Discord de la liga RCL
Documentation=https://github.com/RCLTeam/DiscordBots
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rcl
Group=rcl

# El bot lee .env desde este directorio (pydantic-settings), no hace falta EnvironmentFile.
WorkingDirectory=/opt/rcl/discord-bots

# --no-sync: ejecuta liga-bot con el .venv tal como está, sin instalar ni actualizar
# paquetes. Sin esta opción, uv run sincroniza el entorno antes de arrancar y, si
# .venv no coincide con uv.lock, descarga e instala paquetes en cada arranque
# mientras la sincronización falle (con Restart=always, cada 5 s si falla la red).
# --frozen solo evita volver a resolver uv.lock y no impide esa sincronización;
# --no-sync ya implica --frozen.
# Las dependencias se instalan solo con `uv sync --frozen` (deploy/README.md).
# Si el entorno está incompleto, el arranque falla, el error queda en el journal y
# systemd lo reintenta cada 5 s sin acceder a la red.
ExecStart=/usr/local/bin/uv run --no-sync liga-bot

# uv necesita HOME para su caché; systemd no siempre lo define.
Environment=HOME=/home/rcl
Environment=PYTHONUNBUFFERED=1

# __main__.py atiende SIGTERM y cierra Discord y la BD de forma ordenada.
KillSignal=SIGTERM
# mixed: la SIGTERM va solo al proceso principal (uv), que la reenvía una vez al bot.
# Con el valor por defecto (control-group) el bot la recibiría también de systemd, y
# una segunda señal fuerza la salida sin terminar el cierre. Al agotar TimeoutStopSec,
# systemd envía SIGKILL a todos los procesos del servicio.
KillMode=mixed
TimeoutStopSec=30

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=liga-bot

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
